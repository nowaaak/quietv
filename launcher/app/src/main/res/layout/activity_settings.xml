<?xml version="1.0" encoding="utf-8"?>
<!-- Two panes: the title and the categories stay on the left, the settings of the focused
     category scroll on the right. The list keeps air above and below, and the focused row a
     margin to the edges of the screen (SettingsScroll). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingStart="72dp"
    android:paddingEnd="72dp">

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="64dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textSize="40sp"
            android:fontFamily="@font/geist"
            android:fontVariationSettings="'wght' 600"
            android:letterSpacing="-0.03" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:fontFamily="@font/geist" />

        <LinearLayout
            android:id="@+id/categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:orientation="vertical" />
    </LinearLayout>

    <io.github.nowaaak.quietv.settings.SettingsScroll
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="56dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="64dp"
            android:paddingBottom="112dp" />
    </io.github.nowaaak.quietv.settings.SettingsScroll>
</LinearLayout>

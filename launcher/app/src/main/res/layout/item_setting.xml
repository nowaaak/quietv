<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="@drawable/row_bg"
    android:focusable="true"
    android:clickable="true">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/pill_content"
        android:duplicateParentState="true"
        android:textSize="16sp"
        android:fontFamily="@font/geist"
        android:fontVariationSettings="'wght' 500"
        android:singleLine="true" />

    <TextView
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/pill_content_dim"
        android:duplicateParentState="true"
        android:textSize="14sp"
        android:fontFamily="@font/geist"
        android:singleLine="true" />

    <View
        android:id="@+id/swatch"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/swatch" />
</LinearLayout>

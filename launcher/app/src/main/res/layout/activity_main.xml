<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:alpha="0"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/heroLine"
                android:layout_width="16dp"
                android:layout_height="1.5dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/accent_line" />

            <TextView
                android:id="@+id/heroEyebrow"
                style="@style/Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/selected"
                android:textColor="@color/accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/qvText"
            android:textSize="66sp"
            android:fontFamily="@font/geist"
            android:fontVariationSettings="'wght' 600"
            android:letterSpacing="-0.045"
            android:includeFontPadding="false"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:background="@drawable/key_cap"
                android:text="@string/ok_key"
                android:textColor="?attr/qvText"
                android:textSize="11sp"
                android:fontFamily="@font/geist"
                android:fontVariationSettings="'wght' 600"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/open"
                android:textColor="?attr/qvTextMuted"
                android:textSize="13sp"
                android:fontFamily="@font/geist" />

            <View
                android:layout_width="3dp"
                android:layout_height="3dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/dot"
                android:backgroundTint="?attr/qvLine" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hold_hint"
                android:textColor="?attr/qvTextMuted"
                android:textSize="13sp"
                android:fontFamily="@font/geist" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="32dp"
        android:clipToPadding="false">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:textColor="?attr/qvTextMuted"
                    android:textSize="13sp"
                    android:fontFamily="@font/geist" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="?attr/qvText"
                        android:textSize="44sp"
                        android:fontFamily="@font/geist"
                        android:fontVariationSettings="'wght' 300"
                        android:letterSpacing="-0.04" />

                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="?attr/qvTextMuted"
                        android:textSize="14sp"
                        android:fontFamily="@font/geist"
                        android:textAllCaps="true" />

                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:format12Hour="@string/date_format"
                        android:format24Hour="@string/date_format"
                        android:textColor="?attr/qvTextMuted"
                        android:textSize="14sp"
                        android:fontFamily="@font/geist" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnWifi"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/pill_bg"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusDown="@+id/grid">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_wifi"
                        android:tint="@color/pill_content"
                        android:duplicateParentState="true"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/wifiLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:text="@string/wifi"
                        android:textColor="@color/pill_content"
                        android:duplicateParentState="true"
                        android:textSize="13sp"
                        android:fontFamily="@font/geist"
                        android:fontVariationSettings="'wght' 500"
                        android:singleLine="true" />

                    <View
                        android:id="@+id/wifiDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="9dp"
                        android:background="@drawable/dot" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnInputs"
                    style="@style/TopIconButton"
                    android:src="@drawable/ic_input"
                    android:contentDescription="@string/inputs"
                    android:nextFocusDown="@+id/grid" />

                <ImageView
                    android:id="@+id/btnSettings"
                    style="@style/TopIconButton"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="@string/settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <io.github.nowaaak.quietv.home.FocusRing
        android:id="@+id/ring"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
